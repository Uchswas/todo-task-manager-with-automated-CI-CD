# All environment variables for Docker Compose
# Copy this file to .env and update with your actual values

# Database Configuration
POSTGRES_DB=todo_app_dev
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

POSTGRES_TEST_DB=todo_app_test
POSTGRES_TEST_USER=todo_user_test
POSTGRES_TEST_PASSWORD=CHANGE_ME_STRONG_PASSWORD


# Security Secrets (REQUIRED - generate strong random values)
# Use: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# Flask Configuration
FLASK_ENV=development
FLASK_APP=run.py
SQLALCHEMY_ECHO=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TASKS_PER_PAGE=50

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000
