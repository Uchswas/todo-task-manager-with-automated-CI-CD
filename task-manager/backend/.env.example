# Database Configuration
DATABASE_URL=postgresql://todo_user:password@localhost/todo_app_dev
TEST_DATABASE_URL=postgresql://todo_user:password@localhost/todo_app_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SECRET_KEY=your-flask-secret-key-change-in-production

# Flask Configuration
FLASK_ENV=development
FLASK_APP=run.py

# Database Debug
SQLALCHEMY_ECHO=false

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pagination
TASKS_PER_PAGE=50

# For production deployment
# FLASK_ENV=production
# DATABASE_URL=postgresql://username:password@production-host/todo_app_prod